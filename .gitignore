# --- Личные данные моста: сюда попадают рабочая папка, память модели и логи ---
# Внутри .workbuddy-ai/ лежит память проекта и заметки — им не место в публичном репо.
.workbuddy-ai/

# MEMORY.md — память текущей рабочей папки: пути, состояние, локальные заметки.
# У каждой папки своя, поэтому в публичный репозиторий не коммитится.
MEMORY.md

# Корзина инструмента delete (сюда уходит всё удалённое из рабочей папки)
.trash/

# --- Изолированные данные тестов ---
# test.mjs пишет сюда, чтобы не трогать боевой ~/.dsbridge/
.test-data/
.test-workspace/
.test-workspace-2/
.test-extra/
.test-extra-other/

# --- Артефакты сборки ---
# dsbridge.exe — ~83 МБ, его место в GitHub Releases, а не в истории коммитов
bridge/dist/
dist/
bridge/dist/*.blob
bridge/dist/*.cjs

# --- Сгенерированные файлы ---
# INSTRUCTION.preview.md собирается из content.js и tools.mjs:
#   node extension/render-instruction.mjs
INSTRUCTION.preview.md

# --- Референсные материалы (чужой код, не наш) ---
# 0.5.14/ — распакованный плагин ZCode Computer Use: смотрели его идеи,
# но исходники и node_modules (несколько МБ) в наш репозиторий не нужны.
0.5.14/

# Тестовые скриншоты ручной проверки GUI-автоматизации.
shots/gui-test-*.png

# --- Временные файлы ---
.tmp/

# Вывод тестов, перенаправленный в файл (test-out.txt, ext-test.txt, t.txt и т.п.)
*-out.txt
*-test.txt
bridge/t.txt

# Артефакты боевых проверок на живых сайтах (создаются агентом при тесте связки).
# arena-agent-status.txt — из прогона на arena.ai 28.09.2026.
arena-agent-status.txt

# --- Разное ---
node_modules/
*.log
Thumbs.db
Desktop.ini
